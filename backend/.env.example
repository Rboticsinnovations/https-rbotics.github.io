PORT=5001
MONGODB_URI=mongodb://localhost:27017/rbotics
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# Allowed frontend origin(s), comma-separated, e.g. https://www.rbotics.in,https://rbotics.in
FRONTEND_URL=http://localhost:5173

# Set to "production" on the server (enables secure cookies)
NODE_ENV=development
# Refresh-cookie SameSite: strict (default) | lax | none. Use "none" only if the frontend
# and backend are on unrelated domains (needs HTTPS).
# COOKIE_SAMESITE=strict

# Default admin login (works even without MongoDB)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_me
DEFAULT_ADMIN_NAME=Admin
